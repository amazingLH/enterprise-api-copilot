# Copy to .env in backend. Fill credentials locally; keep .env out of Git.
SECRET_KEY=
model_api_key=
model_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
model_name=YOUR_CHAT_MODEL_ID
sim_api_key=
DASHSCOPE_API_KEY=

# local_mode=1 overrides some hosts. Use 0 for explicit configuration.
local_mode=0
mongo_host=127.0.0.1
mongo_port=27017
mongo_db=tools
milvus_uri=http://127.0.0.1:19530
milvus_db_name=tool_db

topK=5
milvus_similarity_threshold=0.35
model_temperature=0.01
model_top_p=0.01
api_result_max_length=30000
ENHANCED_HUMAN_FEEDBACK=1

# Embedding currently uses model_api_key/model_base_url and text-embedding-v3.
# See docs/architecture.md before changing loop-control configuration.
